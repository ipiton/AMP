# Both Dockerfiles (Dockerfile, Dockerfile.config-reloader) copy only go-app/.
# Keep the rest of the repo -- above all .git and the agent worktrees under
# .claude/ -- out of the build context; the image contents do not change.
.git
.claude
tasks
docs
helm
deploy
# Local outputs of go-app/Makefile, all gitignored: the Go build/module
# cache (GOCACHE, GOMODCACHE, GOPATH -- gigabytes once filled) and the
# binaries. The image downloads modules and builds the binary itself.
go-app/.cache
go-app/server
go-app/server_unix
