# AMP configuration (amp-upstream --amp.config.file=amp.yaml)
#
# This file holds only AMP's own settings. Routes, receivers, inhibit rules,
# time intervals and templates go to alertmanager.yml (--config.file), which
# is upstream Alertmanager's file, read by upstream's parser.
#
# Every key is optional; the values below are the defaults unless marked
# "example". A missing file is not an error: amp-upstream then runs with
# these defaults. Unknown keys are ignored with one warning at start
# ("AMP configuration keys ignored ... keys [...]").
#
# Environment variables override keys: upper case, "." -> "_", e.g.
# DATABASE_PASSWORD, LLM_API_KEY, LLM_ENABLED. Keep secrets there, not here.
#
# With the Helm chart this file is generated from the chart's values
# (<fullname>-amp-config); alertmanager.ampConfig is merged over it. See
# docs/CONFIGURATION_GUIDE.md.

# standard: alert history, investigations and K8s-Secret targets in
#           PostgreSQL.
# lite:     no PostgreSQL. Alerting is unaffected; history, investigations,
#           K8s-Secret targets and /api/amp/v1 (503) are off.
profile: standard

server:
  # Upstream web config (basic auth, TLS options) when --web.config.file is
  # not given; SERVER_WEB_CONFIG_FILE is the same setting from the env.
  web_config_file: ""
  auth:
    # Paths that skip basic auth. Add /metrics for a scraper without
    # credentials. Paths are relative to the --web.external-url path.
    unauthenticated_paths:
      - /-/healthy
      - /-/ready

app:
  # production turns on the database credential checks below.
  environment: development

# Alert history and investigation results (profile standard). Migrations run
# at start. If the database cannot be reached (or a migration fails) at
# start, amp-upstream runs without history and investigations until the next
# restart; alerting works as usual. Invalid credentials under production
# (below) stop the start.
database:
  host: localhost
  port: 5432
  database: alerthistory
  # DATABASE_USERNAME. Empty: no history ("database user is required" in the
  # log), alerting unaffected.
  username: ""
  # DATABASE_PASSWORD. Under app.environment: production the username and
  # password are required and the password must be at least 12 characters
  # and not a known weak one.
  password: ""
  # disable | require | verify-ca | verify-full (allow and prefer are
  # refused: they may fall back to plaintext). disable is refused under
  # production unless
  # allow_insecure_ssl_in_production is true.
  ssl_mode: require
  allow_insecure_ssl_in_production: false
  max_connections: 25
  min_connections: 5
  max_conn_lifetime: 1h
  max_conn_idle_time: 30m
  connect_timeout: 10s

# Classification of firing alerts by an OpenAI-compatible chat API (bring
# your own key). Results reach receivers as llm_severity, llm_confidence,
# llm_reasoning and llm_recommendations annotations.
llm:
  enabled: false
  provider: openai          # openai | openai-compatible
  api_key: ""               # LLM_API_KEY
  base_url: https://api.openai.com/v1
  model: gpt-3.5-turbo
  max_tokens: 1000
  temperature: 0.7
  timeout: 30s
  max_retries: 3
  # How long a notification waits for the classification of its alerts.
  # On timeout it goes out without the annotations.
  notify_wait: 5s
  # true: alerts classified as noise are not delivered (they stay in
  # /api/v2/alerts and in the history).
  drop_noise: false
  # true: investigations run as an agent loop with the tools and runbooks
  # below; false: one LLM call per investigation.
  agent_mode: false

# LLM investigation of firing incidents. Needs llm.enabled and PostgreSQL.
investigation:
  enabled: false
  worker_count: 3
  queue_size: 500
  max_retries: 3
  retry_interval: 5s
  llm_timeout: 60s
  only_firing: true  # false has no effect: only firing alerts are classified, so only they are investigated
  # Agent-mode tools (llm.agent_mode: true). A tool without its settings is
  # not registered.
  tools: {}
  # tools:                                         # example
  #   prometheus:
  #     endpoint: http://prometheus.monitoring.svc:9090
  #     timeout: 10s
  #     # username, password: basic auth (this file only)
  #   loki:
  #     endpoint: http://loki.monitoring.svc:3100
  #     timeout: 10s
  #   kubernetes:
  #     enabled: true
  #     kubeconfig: ""              # empty: in-cluster
  #     # empty: only the alert's namespace label; ["*"]: any namespace
  #     allowed_namespaces: []
  #   database:
  #     enabled: true
  #     # INVESTIGATION_TOOLS_DATABASE_DSN. The database the tool inspects,
  #     # never AMP's own.
  #     dsn: ""
  runbooks:
    enabled: false              # needs llm.agent_mode: true
    path: /etc/amp/runbooks
    max_runbooks: 3
    max_chars: 4000

# Kubernetes Secrets as receiver integrations (profile standard; needs the
# Kubernetes API). See docs/ALERTMANAGER_COMPATIBILITY.md#kubernetes-secret-targets.
publishing:
  enabled: true
  discovery:
    # Empty: the pod's own namespace (POD_NAMESPACE, else the service
    # account namespace).
    namespace: ""
    label_selector: publishing-target=true
  refresh:
    interval: 5m
